import cv2
import os
from typing import Optional

def extract_first_frame(video_path: str, output_image_path: str) -> bool:
    """
    Извлекает первый кадр из видео и сохраняет его как изображение.

    return: True / False
    """
    if not os.path.exists(video_path):
        print(f"Видео не найдено: {video_path}")
        return False

    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        print(f"Не удалось открыть видео: {video_path}")
        return False

    ret, frame = cap.read()
    cap.release() 
    if not ret:
        print("Не удалось прочитать первый кадр")
        return False

    os.makedirs(os.path.dirname(output_image_path), exist_ok=True)

    success = cv2.imwrite(output_image_path, frame)
    if success:
        print(f"Первый кадр сохранён: {output_image_path}")
        return True
    else:
        print(f"Не удалось сохранить изображение: {output_image_path}")
        return False
